// Multi-tenant vehicle rental management.
//
// Tenancy rule: every tenant-owned model carries `organizationId`. No feature code
// writes that filter by hand -- src/server/db/tenant.ts injects it for every query.
// See tests/isolation for the suite that holds this honest.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  FREE
}

enum OrgStatus {
  ACTIVE
  SUSPENDED
}

enum Role {
  OWNER
  MANAGER
  STAFF
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum VehicleCategory {
  CAR
  BIKE
  SCOOTER
  VAN
  TRUCK
  OTHER
}

enum VehicleStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  RETIRED
}

enum BookingStatus {
  RESERVED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RateType {
  DAILY
  WEEKLY
  MONTHLY
}

enum ServiceStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum ChargeKind {
  RENTAL
  EXTRA
  LATE_FEE
  DAMAGE
}

enum PaymentKind {
  RENTAL
  DEPOSIT
  DEPOSIT_REFUND
  REFUND
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  plan      Plan      @default(FREE)
  status    OrgStatus @default(ACTIVE)
  // Hands out human-readable booking numbers (BK-0001) per tenant. Incremented inside
  // the booking transaction so two counter staff cannot be given the same number.
  bookingSeq Int      @default(0)

  // Invoice identity. A GST invoice has to carry the supplier's registered name,
  // address, state and GSTIN, so these live on the organization rather than being
  // typed in each time.
  legalName   String?
  gstin       String?
  addressLine String?
  city        String?
  state       String?
  // The two-digit GST state code, which decides CGST+SGST versus IGST.
  stateCode   String?
  postalCode  String?
  // Renting a motor vehicle attracts different rates depending on how the business is
  // registered, so the rate is the organization's to set.
  gstRate     Decimal @default(18) @db.Decimal(5, 2)
  /// GST invoice numbers must be consecutive and unique within a financial year, so the
  /// counter records which year it belongs to and restarts each April.
  invoiceSeq  Int     @default(0)
  invoiceFy   String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  branches  Branch[]
  users     User[]
  vehicles  Vehicle[]
  customers Customer[]
  bookings  Booking[]
  charges   BookingCharge[]
  payments     Payment[]
  invoices     Invoice[]
  invoiceLines InvoiceLine[]
  services     ServiceSchedule[]
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  address        String?
  phone          String?
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  vehicles     Vehicle[]
  bookings     Booking[]

  @@index([organizationId])
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  // Login is global, so email is unique across the whole platform rather than per org.
  email          String     @unique
  passwordHash   String
  name           String
  role           Role       @default(STAFF)
  // Owners span every branch, so their branchId is null.
  branchId       String?
  status         UserStatus @default(ACTIVE)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch          Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  createdBookings Booking[]       @relation("BookingCreatedBy")
  createdCharges  BookingCharge[] @relation("ChargeCreatedBy")
  takenPayments   Payment[]       @relation("PaymentReceivedBy")
  issuedInvoices  Invoice[]         @relation("InvoiceIssuedBy")
  createdServices ServiceSchedule[] @relation("ServiceCreatedBy")

  @@index([organizationId])
  @@index([branchId])
}

model Vehicle {
  id                 String          @id @default(cuid())
  organizationId     String
  branchId           String
  category           VehicleCategory
  registrationNumber String
  make               String
  model              String
  year               Int?
  color              String?
  status             VehicleStatus   @default(AVAILABLE)
  odometer           Int             @default(0)
  dailyRate          Decimal         @db.Decimal(12, 2)
  weeklyRate         Decimal?        @db.Decimal(12, 2)
  monthlyRate        Decimal?        @db.Decimal(12, 2)
  depositAmount      Decimal         @default(0) @db.Decimal(12, 2)
  // Category-specific fields: seats, transmission, fuelType, engineCc, loadCapacity...
  attributes         Json            @default("{}")
  notes              String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch            @relation(fields: [branchId], references: [id], onDelete: Restrict)
  bookings     Booking[]
  services     ServiceSchedule[]

  @@unique([organizationId, registrationNumber])
  @@index([organizationId])
  @@index([branchId])
  @@index([organizationId, status])
}

/// One line of what the customer is being billed: the rental itself, plus anything
/// added when the vehicle comes back. Separate from the booking's estimated total,
/// because what was quoted and what is owed diverge as soon as a return is late.
model BookingCharge {
  id             String     @id @default(cuid())
  organizationId String
  bookingId      String
  kind           ChargeKind @default(EXTRA)
  description    String
  quantity       Decimal    @default(1) @db.Decimal(12, 2)
  unitAmount     Decimal    @db.Decimal(12, 2)
  /// quantity x unitAmount, held so a stored line never has to be recomputed.
  amount         Decimal    @db.Decimal(12, 2)
  /// A refundable deposit is not a supply, so not everything on a bill carries GST.
  taxable        Boolean    @default(true)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("ChargeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([bookingId])
}

/// Money actually taken at the counter. The app is a ledger, not a payment processor,
/// so `reference` holds whatever the UPI app or card machine printed.
model Payment {
  id             String        @id @default(cuid())
  organizationId String
  bookingId      String
  kind           PaymentKind   @default(RENTAL)
  /// Always positive; `kind` says which way the money moved.
  amount         Decimal       @db.Decimal(12, 2)
  method         PaymentMethod @default(CASH)
  reference      String?
  notes          String?
  receivedAt     DateTime      @default(now()) @db.Timestamptz(3)

  receivedByUserId String?
  createdAt        DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking        Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  receivedByUser User?        @relation("PaymentReceivedBy", fields: [receivedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([bookingId])
}

/// A GST invoice, snapshotted in full.
///
/// Everything the document shows is copied in at the moment it is issued -- the
/// supplier's registered details, the customer, the rate, every line. Raising a
/// vehicle's daily rate in July must not alter an invoice issued in June.
model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  bookingId      String   @unique
  invoiceNumber  String
  financialYear  String
  issuedAt       DateTime @default(now()) @db.Timestamptz(3)

  supplierName      String
  supplierGstin     String?
  supplierAddress   String?
  supplierState     String?
  supplierStateCode String?

  customerName    String
  customerPhone   String
  customerAddress String?

  /// For renting a motor vehicle handed over at the branch, this is the branch's state.
  placeOfSupply String?

  gstRate         Decimal @db.Decimal(5, 2)
  taxableTotal    Decimal @db.Decimal(12, 2)
  nonTaxableTotal Decimal @default(0) @db.Decimal(12, 2)
  cgstTotal       Decimal @db.Decimal(12, 2)
  sgstTotal       Decimal @db.Decimal(12, 2)
  grandTotal      Decimal @db.Decimal(12, 2)

  issuedByUserId String?
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  issuedByUser User?         @relation("InvoiceIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  lines        InvoiceLine[]

  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
}

model InvoiceLine {
  id String @id @default(cuid())
  /// Carried here too, so the rule that every tenant-owned row has an organizationId
  /// holds without exception and a direct query can still be scoped.
  organizationId String
  invoiceId      String
  description  String
  /// Service accounting code. 9966 covers renting transport vehicles.
  sacCode      String?
  quantity     Decimal @db.Decimal(12, 2)
  unitAmount   Decimal @db.Decimal(12, 2)
  taxableValue Decimal @db.Decimal(12, 2)
  taxable      Boolean @default(true)
  cgstRate     Decimal @db.Decimal(5, 2)
  cgstAmount   Decimal @db.Decimal(12, 2)
  sgstRate     Decimal @db.Decimal(5, 2)
  sgstAmount   Decimal @db.Decimal(12, 2)
  lineTotal    Decimal @db.Decimal(12, 2)
  position     Int     @default(0)

  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([organizationId])
}

/// A booked workshop slot. Without dates, "in service" is only ever a state now; with
/// them a vehicle can be taken off the road for a window, and that window blocks
/// bookings the same way another rental does.
model ServiceSchedule {
  id             String        @id @default(cuid())
  organizationId String
  vehicleId      String
  status         ServiceStatus @default(SCHEDULED)
  reason         String
  notes          String?
  startAt        DateTime      @db.Timestamptz(3)
  endAt          DateTime      @db.Timestamptz(3)

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle       Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  createdByUser User?        @relation("ServiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([vehicleId, startAt, endAt])
  @@index([organizationId, status])
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  fullName       String
  phone          String
  email          String?
  licenceNumber  String?
  address        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]

  @@index([organizationId])
  @@index([organizationId, phone])
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  branchId       String
  vehicleId      String
  customerId     String
  bookingNumber  String
  status         BookingStatus @default(RESERVED)

  // Planned window. The no-overlap exclusion constraint is defined on these
  // in a raw migration -- Prisma cannot express EXCLUDE USING gist.
  startAt DateTime @db.Timestamptz(3)
  endAt   DateTime @db.Timestamptz(3)

  // What actually happened.
  actualStartAt DateTime? @db.Timestamptz(3)
  actualEndAt   DateTime? @db.Timestamptz(3)

  rateType       RateType @default(DAILY)
  ratePerUnit    Decimal  @db.Decimal(12, 2)
  estimatedTotal Decimal  @db.Decimal(12, 2)
  depositAmount  Decimal  @default(0) @db.Decimal(12, 2)
  notes          String?

  // Check-out / check-in live on the booking: one lifecycle, one row.
  checkoutOdometer  Int?
  checkoutFuelLevel Int?
  checkoutNotes     String?
  checkinOdometer   Int?
  checkinFuelLevel  Int?
  checkinNotes      String?
  damageNotes       String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch          @relation(fields: [branchId], references: [id], onDelete: Restrict)
  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdByUser User?           @relation("BookingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  charges       BookingCharge[]
  payments      Payment[]
  invoice       Invoice?

  @@unique([organizationId, bookingNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([vehicleId, startAt, endAt])
  @@index([branchId])
}
